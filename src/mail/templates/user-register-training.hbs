<html lang='es'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>Confirmación de Inscripción - Caché Marketing</title>
        <style>
            /* Optimización para dispositivos móviles */
            @media screen and (max-width: 600px) {
                .container {
                    width: 100% !important;
                    border-radius: 0 !important;
                }
                .content-padding {
                    padding-left: 15px !important;
                    padding-right: 15px !important;
                }
                .details-table {
                    border-radius: 0 !important;
                    border-left: none !important;
                    border-right: none !important;
                }
            }
        </style>
    </head>
    <body
        style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f4f7; color: #333333;"
    >

        <table
            align='center'
            border='0'
            cellpadding='0'
            cellspacing='0'
            width='100%'
            class='container'
            style='max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08); margin: 20px auto;'
        >

            <!-- Banner Superior: Ocupa el 100% del ancho -->
            <tr>
                <td align='center' style='background-color: #0d1b2a;'>
                    <img
                        src='{{training_banner_url}}'
                        alt='Banner de Bienvenida'
                        width='600'
                        style='display: block; width: 100%; height: auto; border: none;'
                    />
                </td>
            </tr>

            <!-- Encabezado -->
            <tr>
                <td
                    align='center'
                    class='content-padding'
                    style='padding: 30px 20px 10px 20px;'
                >
                    <div
                        style='background-color: #003853; color: #ffffff; display: inline-block; padding: 6px 20px; border-radius: 50px; font-weight: bold; font-size: 13px; text-transform: uppercase; margin-bottom: 15px;'
                    >
                        Inscripción Confirmada ✅
                    </div>
                    <h2
                        style='color: #0d1b2a; margin: 0; font-size: 26px;'
                    >¡Hola, {{user_full_name}}!</h2>
                </td>
            </tr>

            <!-- Mensaje de Introducción -->
            <tr>
                <td
                    class='content-padding'
                    style='padding: 10px 20px 20px 20px; line-height: 1.6; font-size: 16px; color: #444444; text-align: center;'
                >
                    <p style='margin: 0;'>Tu inscripción ha sido
                        <strong>confirmada exitosamente</strong>. Estamos listos
                        para comenzar esta experiencia formativa contigo.</p>
                </td>
            </tr>

            <!-- CAJA DE DETALLES: Ahora ocupa todo el ancho disponible -->
            <tr>
                <td style='padding: 0;'>
                    <table
                        class='details-table'
                        border='0'
                        cellpadding='0'
                        cellspacing='0'
                        width='100%'
                        style='background-color: #f8f9fa; border-top: 1px solid #eeeeee; border-bottom: 1px solid #eeeeee;'
                    >
                        <tr>
                            <td
                                class='content-padding'
                                style='padding: 30px 40px;'
                            >
                                <h3
                                    style='color: #003853; margin-top: 0; margin-bottom: 20px; font-size: 18px; text-transform: uppercase; letter-spacing: 1px;'
                                >📍 Detalles del Evento</h3>

                                <table
                                    border='0'
                                    cellpadding='0'
                                    cellspacing='0'
                                    width='100%'
                                >
                                    <tr>
                                        <td
                                            style='padding: 8px 0; border-bottom: 1px solid #e1e4e8; font-size: 15px;'
                                        >
                                            <strong
                                                style='color: #0d1b2a;'
                                            >Fecha:</strong>
                                            {{training_date}}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td
                                            style='padding: 8px 0; border-bottom: 1px solid #e1e4e8; font-size: 15px;'
                                        >
                                            <strong
                                                style='color: #0d1b2a;'
                                            >Hora:</strong>
                                            {{training_start}}
                                            -
                                            {{training_end}}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td
                                            style='padding: 8px 0; font-size: 15px;'
                                        >
                                            <strong
                                                style='color: #0d1b2a;'
                                            >Lugar:</strong>
                                            {{training_location}}
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <!-- Cierre -->
            <tr>
                <td
                    class='content-padding'
                    style='padding: 30px 20px; text-align: center; font-size: 15px; color: #666666;'
                >
                    <p style='margin: 0;'>Nos vemos pronto para vivir una
                        jornada de aprendizaje práctico.</p>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td
                    align='center'
                    style='padding: 30px 20px; background-color: #0d1b2a; color: #ffffff; font-size: 12px;'
                >
                    <p
                        style='margin: 0 0 5px 0; font-weight: bold; font-size: 15px; letter-spacing: 1px;'
                    >CACHÉ MARKETING</p>
                    <p style='margin: 0; opacity: 0.7;'>Maturín, Monagas,
                        Venezuela</p>
                    <div
                        style='margin: 20px 0; border-top: 1px solid rgba(255,255,255,0.1); width: 80%;'
                    ></div>
                    <p
                        style='margin: 0; opacity: 0.5; font-size: 10px; line-height: 1.4;'
                    >
                        Este es un correo automático. Por favor, no respondas
                        directamente.
                    </p>
                </td>
            </tr>
        </table>
    </body>
</html>